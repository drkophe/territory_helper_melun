# Mot de passe pour l'authentification simple
AUTH_PASSWORD=melun2024

# Secret pour signer les cookies de session
# Générer avec : openssl rand -base64 32
AUTH_SECRET=changez-ce-secret-en-production

# Google Sheets Configuration (Sprint 2)
# ID du Google Sheet (extrait de l'URL)
GOOGLE_SHEET_ID=votre-sheet-id-ici

# Email du service account Google
GOOGLE_SERVICE_ACCOUNT_EMAIL=votre-service-account@projet.iam.gserviceaccount.com

# Clé privée du service account (JSON key, avec les \n échappés)
# Format: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nVOTRE_CLE_PRIVEE_ICI\n-----END PRIVATE KEY-----\n"
